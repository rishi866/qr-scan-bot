# ─────────────────────────────────────────────────────────────────────────────
# QR Exchange - configuration. Copy to `.env` (chmod 600) and fill in.
# Never commit the real .env. Anything marked REQUIRED must be set before the first start.
# deploy/install_vps.sh creates this file for you and generates the secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── domain / TLS ─────────────────────────────────────────────────────────────
# REQUIRED. The DNS A record of this name must point at the VPS before you start (Caddy
# fetches a Let's Encrypt certificate on the first request). Example: admin.example.com
DOMAIN=
# REQUIRED. Let's Encrypt expiry notices go here.
ACME_EMAIL=

# ── database ─────────────────────────────────────────────────────────────────
# REQUIRED. Letters and digits only (it ends up inside a URL). `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_USER=qrbot
POSTGRES_DB=qrbot

# ── core ─────────────────────────────────────────────────────────────────────
# REQUIRED. >= 32 random characters: signs login cookies and encrypts 2FA secrets.
# `openssl rand -hex 32`. Changing it later signs every admin out and invalidates enrolled 2FA.
SECRET_KEY=
LOG_LEVEL=INFO

# ── Telegram ─────────────────────────────────────────────────────────────────
# REQUIRED. From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# REQUIRED. Comma-separated numeric Telegram IDs of the admins. They receive approval requests and can
# use /admin. Find yours with @userinfobot.
ADMIN_TELEGRAM_IDS=

# ── web panel ────────────────────────────────────────────────────────────────
# Optional: creates the first panel admin on startup if none exists. Prefer the interactive command
#   docker compose run --rm api python -m app.cli create-admin
# and leave the password empty.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_TTL_HOURS=12

# ── BEP-20 (USDT on BNB Smart Chain) deposits ────────────────────────────────
# Public RPC endpoints are rate-limited. For real volume use a provider (Ankr, QuickNode, NodeReal...).
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Number of confirmations before a deposit is credited.
DEPOSIT_CONFIRMATIONS=15
# Watch-only account xpub (m/44'/60'/0'). Generate on a safe machine with `python -m app.cli gen-wallet`
# and keep the mnemonic OFFLINE. The server derives one deposit address per seller from the xpub and can never
# spend from them. Leave empty to disable BEP-20 deposits.
HD_XPUB=
# Only if you want the server itself to sweep deposit addresses (python -m app.cli sweep). Not recommended.
HD_MNEMONIC=

# ── payouts ──────────────────────────────────────────────────────────────────
# Default: manual - an admin approves each withdrawal in the panel, sends the money and presses "Mark paid".
# Automatic BEP-20 payouts from a hot wallet (keep only a small float in it!):
AUTO_PAYOUT_ENABLED=false
AUTO_PAYOUT_MAX_AMOUNT=50
PAYOUT_PRIVATE_KEY=

# ── Binance (optional) ───────────────────────────────────────────────────────
# READ-ONLY API key used to verify "I paid via Binance" claims. Do NOT enable withdrawals on it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── AI screenshot check for disputes (optional) ──────────────────────────────
# Without a key every dispute goes to an admin. Any vision-capable Claude model id works.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
