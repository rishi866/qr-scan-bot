# ─────────────────────────────────────────────────────────────────────────────
# QR Exchange - configuration. Copy to `.env` (chmod 600) and fill in.
# Never commit the real .env. Anything marked REQUIRED must be set before the first start.
# deploy/install_vps.sh creates this file for you and generates the secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── domain / TLS ─────────────────────────────────────────────────────────────
# REQUIRED. The DNS A record of this name must point at the VPS before you start (Caddy
# fetches a Let's Encrypt certificate on the first request). Example: admin.example.com
DOMAIN=
# REQUIRED. Let's Encrypt expiry notices go here.
ACME_EMAIL=

# ── database ─────────────────────────────────────────────────────────────────
# Default: the PostgreSQL container that ships with docker-compose. This line switches it on.
COMPOSE_PROFILES=local-db
# Required for the container. Letters and digits only (it ends up inside a URL). `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_USER=qrbot
POSTGRES_DB=qrbot
#
# Or: a hosted database (Supabase) - see docs/SUPABASE.md. Delete COMPOSE_PROFILES above, then set:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
# DB_SCHEMA=qrbot            # all tables go into this schema (NOT the API-exposed "public")
# DB_POOL_SIZE=3             # connections per process (the API and the bot each have their own pool)
# DB_MAX_OVERFLOW=2
# PGSSLROOTCERT=/certs/supabase-ca.crt   # optional, with ?ssl=verify-full in DATABASE_URL: verify the server certificate (docs/SUPABASE.md)

# ── core ─────────────────────────────────────────────────────────────────────
# REQUIRED. >= 32 random characters: signs login cookies and encrypts 2FA secrets.
# `openssl rand -hex 32`. Changing it later signs every admin out and invalidates enrolled 2FA.
SECRET_KEY=
LOG_LEVEL=INFO

# ── Telegram ─────────────────────────────────────────────────────────────────
# REQUIRED. From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# REQUIRED. Comma-separated numeric Telegram IDs of the admins. They receive approval requests and can
# use /admin. Find yours with @userinfobot.
ADMIN_TELEGRAM_IDS=

# ── web panel ────────────────────────────────────────────────────────────────
# Optional: creates the first panel admin on startup if none exists. Prefer the interactive command
#   docker compose run --rm api python -m app.cli create-admin
# and leave the password empty.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_TTL_HOURS=12

# ── BEP-20 (USDT on BNB Smart Chain) deposits ────────────────────────────────
# Public RPC endpoints are rate-limited. For real volume use a provider (Ankr, QuickNode, NodeReal...).
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Number of confirmations before a deposit is credited.
DEPOSIT_CONFIRMATIONS=15
# Watch-only account xpub (m/44'/60'/0'). Generate on a safe machine with `python -m app.cli gen-wallet`
# and keep the mnemonic OFFLINE. The server derives one deposit address per seller from the xpub and can never
# spend from them. Leave empty to disable BEP-20 deposits.
HD_XPUB=
# Only if you want the server itself to sweep deposit addresses (python -m app.cli sweep). Not recommended.
HD_MNEMONIC=

# ── payouts ──────────────────────────────────────────────────────────────────
# Default: manual - an admin approves each withdrawal in the panel, sends the money and presses "Mark paid".
# Automatic BEP-20 payouts from a hot wallet (keep only a small float in it!):
AUTO_PAYOUT_ENABLED=false
AUTO_PAYOUT_MAX_AMOUNT=50
PAYOUT_PRIVATE_KEY=

# ── Binance (optional) ───────────────────────────────────────────────────────
# READ-ONLY API key used to verify "I paid via Binance" claims. Do NOT enable withdrawals on it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── AI screenshot check for disputes (optional) ──────────────────────────────
# Without a key every dispute goes to an admin. Any vision-capable Claude model id works.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── advanced / development (all optional; the defaults are right for production) ─────────────
# docker-compose derives PUBLIC_BASE_URL / UPLOAD_DIR / ENVIRONMENT (and DATABASE_URL for the local container) itself; set them
# only for the non-Docker setup or local development:
# DATABASE_URL=postgresql+asyncpg://qrbot:PASSWORD@127.0.0.1:5432/qrbot
# DB_POOL_RECYCLE_SECONDS=1800                   # replace pooled connections before a proxy / firewall drops them
# PUBLIC_BASE_URL=https://admin.example.com      # https is required for the time-zone Mini App
# UPLOAD_DIR=/var/lib/qrbot/uploads              # dispute screenshots
# ENVIRONMENT=production                         # production | development | test
# COOKIE_SECURE=true                             # false only for plain-http local development
# CORS_ORIGINS=http://localhost:3000             # only for `npm run dev` on another port
# ADMIN_STATIC_DIR=../frontend/out               # let the API serve the built panel (development)
# TOTP_ISSUER=QR Exchange Admin                  # label shown in the authenticator app
# BSC_CHAIN_ID=56
# TOKEN_CONTRACT=0x55d398326f99059fF775485246999027B3197955   # Binance-Peg USDT (BEP-20)
# TOKEN_SYMBOL=USDT
# TOKEN_DECIMALS=18
# BSC_SCAN_CHUNK=2000                            # blocks per eth_getLogs call (lower it if your RPC limits ranges)
# BSC_SCAN_START_BLOCK=45000000                 # first scan only: block to start from (default: the current head)
# BINANCE_BASE_URL=https://api.binance.com
