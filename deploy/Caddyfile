# Caddy: HTTPS, the admin panel (static files) and the /api reverse proxy.
# DOMAIN and ACME_EMAIL come from deploy/.env (docker-compose passes them in).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# JSON API (security headers are added by the API itself)
	handle /api/* {
		reverse_proxy api:8000
	}

	# Telegram Mini App that detects the user's time zone. It runs inside Telegram (an iframe on
	# Telegram Web), so it may only be framed by Telegram, and it loads telegram.org's script.
	handle /tz.html {
		header Content-Security-Policy "frame-ancestors https://web.telegram.org https://webk.telegram.org https://webz.telegram.org https://*.telegram.org"
		header X-Content-Type-Options nosniff
		header Referrer-Policy same-origin
		root * /srv/panel
		file_server
	}

	# The admin panel: never frameable, nothing loaded from other origins
	handle {
		header {
			X-Frame-Options DENY
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		root * /srv/panel
		file_server
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			header X-Frame-Options DENY
			file_server {
				root /srv/panel
			}
		}
	}
}
